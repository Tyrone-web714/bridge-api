{
  "schemaVersion": "intelligence.decision.governance.policy.profile.v1",
  "version": "0.1.0",
  "lifecycleState": "APPROVED_FOR_TEST",
  "enabled": true,
  "testOnly": true,
  "productionUseAllowed": false,
  "productionApprovalAllowed": false,
  "certificationClaimsAllowed": false,
  "safetyExceptionAllowed": false,
  "privacyExceptionAllowed": false,
  "tenantIsolationExceptionAllowed": false,
  "employmentGovernanceExceptionAllowed": false,
  "allowedActorTypes": [
    "SYSTEM",
    "TEST_HARNESS",
    "REVIEWER",
    "UNKNOWN"
