# Truck-Safe Routing pilot environment template.
# Placeholders only. Do not put real secrets in this file.

NODE_ENV=production
PORT=5000

# Owner/infrastructure approved pilot backend URLs.
PUBLIC_API_BASE_URL=<APPROVED_PILOT_API_HTTPS_URL>
BACKEND_PUBLIC_URL=<APPROVED_PILOT_API_HTTPS_URL>
CORS_ORIGIN=<APPROVED_SUPERVISOR_OR_ADMIN_HTTPS_ORIGIN>

# Server-side Google Maps key from the approved pilot Google project.
GOOGLE_MAPS_API_KEY=<PILOT_SERVER_SIDE_GOOGLE_MAPS_KEY>

# Infrastructure-generated hosted PostgreSQL URL. Secret-containing.
DATABASE_URL=<PILOT_DATABASE_URL>
DATABASE_SSL=true
PG_POOL_MAX=20
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000

# Admin and driver security. Secret-containing.
ADMIN_DASHBOARD_PASSWORD=<PILOT_ADMIN_DASHBOARD_PASSWORD>
ADMIN_DASHBOARD_SECRET=<PILOT_ADMIN_DASHBOARD_SESSION_SECRET_32_PLUS_CHARS>
DRIVER_API_TOKEN=<PILOT_DRIVER_API_TOKEN_32_PLUS_CHARS>
ALLOW_LEGACY_DRIVER_API_TOKEN=false

# Private durable media storage. Required if photos/media are included in pilot scope.
PHOTO_STORAGE_PROVIDER=s3
PHOTO_STORAGE_BUCKET=<PILOT_PRIVATE_MEDIA_BUCKET>
PHOTO_STORAGE_REGION=<PILOT_PRIVATE_MEDIA_REGION>
PHOTO_STORAGE_ENDPOINT=<PILOT_R2_OR_S3_ENDPOINT_IF_REQUIRED>
PHOTO_STORAGE_FORCE_PATH_STYLE=true
PHOTO_STORAGE_ACCESS_KEY_ID=<PILOT_PRIVATE_MEDIA_ACCESS_KEY_ID>
PHOTO_STORAGE_SECRET_ACCESS_KEY=<PILOT_PRIVATE_MEDIA_SECRET_ACCESS_KEY>
PHOTO_STORAGE_PUBLIC_BASE_URL=

# AI provider credentials are not required for initial live pilot.
# D1 is OFF and D2 production routing is OFF/SHADOW_ONLY at most.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Mutating pilot integration validation must use disposable local PostgreSQL only.
# Do not set these in production or live pilot environments.
PILOT_INTEGRATION_TEST=false
ALLOW_MUTATING_TEST_DATA=false
